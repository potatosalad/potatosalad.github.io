#!/usr/bin/env bash

set -e # exit immediately if any commands fail
set -x # debug mode

if [[ ! -f /.dockerenv && ! -f /run/.containerenv ]]; then
  echo "error: util/deploy must run inside the project container" >&2
  exit 1
fi

ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )/../" && pwd )"
SRC="$ROOT/_site"
TMP="$ROOT/.tmp"
DST="$TMP/_site"

function prepare() {
  local branch="$1"
  local remote="$2"
  if [[ ! -d "$DST" ]]; then
    mkdir -p "$TMP"
    git clone "$remote" "$DST"
  fi
  cd "$DST"
  git remote set-url origin "$remote"
  git fetch origin
  git checkout "$branch"
  git reset --hard "origin/$branch"
  git clean -dfx
  (git rm -rf --quiet . 1>/dev/null 2>/dev/null) || true
  git config user.name "$(git -C "$ROOT" log -1 --format='%an')"
  git config user.email "$(git -C "$ROOT" log -1 --format='%ae')"
}

function build() {
  cd "$ROOT"
  JEKYLL_ENV=production bundle exec jekyll build
  rsync -a "$SRC/" "$DST/"
  cd "$DST"
  touch .nojekyll
}

function publish() {
  local branch="$1"
  cd "$DST"
  git add --all
  if git diff --cached --quiet; then
    echo "No site changes to deploy."
    return
  fi
  git commit -m "Deployment $(date '+%Y-%m-%d %H:%M:%S %z')"
  if [[ "${DEPLOY_DRY_RUN:-0}" == "1" ]]; then
    echo "Dry run requested; skipping push."
  else
    git push origin "$branch"
  fi
}

function deploy() {
  local branch="$1"
  local remote="$2"
  prepare "$branch" "$remote"
  build
  publish "$branch"
}

deploy "master" "git@github.com:potatosalad/potatosalad.github.io.git"

exit 0
